# DigitalOcean MongoDB Connection
# Replace with your actual connection string after setting up MongoDB droplet
MONGODB_URI=mongodb://nuchoate_app:YOUR_PASSWORD@YOUR_DROPLET_IP:27017/nu_choate_league?authSource=nu_choate_league

# Database name
DATABASE_NAME=nu_choate_league

# Sleeper API Configuration
SLEEPER_LEAGUE_ID=1251998020954763264

# JWT Secret for authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your_secret_key_here_change_this_in_production

# Environment
API_ENV=development

# Port (for local development)
PORT=8000
