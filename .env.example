# Copy this file to .env and edit that copy. Do not commit .env.

# Postgres (docker compose). If you change the password, change it in BOTH
# POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_USER=nu_choate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nu_choate
DATABASE_URL=postgresql://nu_choate:change-me@localhost:5433/nu_choate

# ESPN cookies: Chrome → espn.com → F12 → Application → Cookies.
# Keep the curly braces on SWID. Leave espn_s2 URL-encoded (includes % characters).
# Only needed to dump 2022–2023. Not needed for Sleeper or for load/query.
ESPN_S2=
ESPN_SWID=

# ESPN league ids (the number after leagueId= in the ESPN league URL).
ESPN_LEAGUE_2022=1543741350
ESPN_LEAGUE_2023=80296044

# Current Sleeper league id from the league URL. No API token.
# The dumper walks previous_league_id back until SLEEPER_MIN_SEASON.
SLEEPER_LEAGUE_ID=1313409735290028032
SLEEPER_MIN_SEASON=2024
